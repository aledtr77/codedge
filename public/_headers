/*
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; script-src 'self' 'unsafe-inline' https://static.cloudflareinsights.com; script-src-attr 'none'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' https://api.emailjs.com https://cloudflareinsights.com; form-action 'self'; frame-src 'none'; manifest-src 'self'; upgrade-insecure-requests
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=(), xr-spatial-tracking=()
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  X-Permitted-Cross-Domain-Policies: none

# No Cache-Control rules here: Pages serves the static files with its own
# max-age (sw.js goes out with max-age=14400) and ignores whatever we write.
# The service worker still updates right after a deploy, because
# src/scripts/components/pwa.js registers it with updateViaCache:"none", which
# skips the HTTP cache when the browser checks whether a newer worker exists.

# The script that picks the language and the anti-FOUC ones are inline and
# cannot move out: they run before the first paint. Rather than open the door to
# any inline script with 'unsafe-inline', the CSP above is rewritten at the end
# of the build with the SHA-256 hashes of those four — see cspHashesPlugin in
# vite.config.js. So 'unsafe-inline' in script-src holds for `npm run dev` only:
# it is not in the published dist.
