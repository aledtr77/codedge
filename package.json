{
  "name": "codedge",
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "private": true,
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/generate-seo-assets.mjs",
    "build": "vite build",
    "preview": "vite preview --port 5000",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:smoke": "node scripts/smoke.mjs",
    "test:a11y": "node scripts/a11y.mjs",
    "test:css-labs": "node scripts/css-labs-check.mjs",
    "i18n:drift": "node scripts/i18n-drift.mjs",
    "i18n:sync": "node scripts/i18n-drift.mjs --update",
    "i18n:lint": "node scripts/i18n-lint.mjs",
    "i18n:swap": "node scripts/i18n-swap.mjs",
    "i18n:scaffold": "node scripts/i18n-scaffold.mjs",
    "badge": "node scripts/sync-test-badge.mjs",
    "badge:check": "node scripts/sync-test-badge.mjs --check",
    "test:security": "node scripts/security-check.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "html-minifier-terser": "^7.2.0",
    "playwright-core": "^1.65.1",
    "vite": "^8.3.8",
    "vite-imagetools": "^10.0.1",
    "vitest": "^4.1.12",
    "wrangler": "^4.165.0"
  },
  "homepage": "https://codedge.it/",
  "dependencies": {
    "@emailjs/browser": "^4.4.1",
    "@fortawesome/fontawesome-free": "^7.3.1",
    "@jaames/iro": "^5.5.2",
    "@jsquash/avif": "^2.1.1",
    "image-q": "^4.0.0",
    "prismjs": "^1.30.0"
  },
  "overrides": {
    "preact": "10.29.1",
    "undici": "^7.30.2"
  },
  "license": "MIT"
}
