{
  "name": "codedge",
  "version": "1.0.0",
  "engines": {
    "node": ">=22"
  },
  "private": true,
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/generate-seo-assets.mjs",
    "build": "vite build",
    "preview": "vite preview --port 5000",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:smoke": "node scripts/smoke.mjs",
    "test:a11y": "node scripts/a11y.mjs",
    "i18n:drift": "node scripts/i18n-drift.mjs",
    "i18n:sync": "node scripts/i18n-drift.mjs --update",
    "i18n:lint": "node scripts/i18n-lint.mjs",
    "i18n:swap": "node scripts/i18n-swap.mjs",
    "i18n:scaffold": "node scripts/i18n-scaffold.mjs",
    "badge": "node scripts/sync-test-badge.mjs",
    "badge:check": "node scripts/sync-test-badge.mjs --check"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "esbuild": "^0.28.1",
    "eslint": "^10.8.0",
    "globals": "^17.9.0",
    "html-minifier-terser": "^7.2.0",
    "playwright-core": "^1.62.0",
    "vite": "^8.0.7",
    "vite-imagetools": "^10.0.1",
    "vitest": "^4.1.10",
    "wrangler": "^4.118.0"
  },
  "homepage": "https://codedge.it/",
  "dependencies": {
    "@emailjs/browser": "^4.4.1",
    "@fortawesome/fontawesome-free": "^7.0.1",
    "@jaames/iro": "^5.5.2",
    "compressorjs": "^1.2.1",
    "prismjs": "^1.30.0"
  },
  "overrides": {
    "preact": "10.29.1",
    "undici": "^7.29.0"
  },
  "license": "MIT"
}
